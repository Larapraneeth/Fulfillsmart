# ==============================================================================
# FulfillSmart Environment Configuration Template
# Copy this file to .env for local overrides (never commit actual .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Render Web Service)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PYTHON_VERSION=3.11.9
PORT=8000

# Master API Key for backend route protection
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
FULFILLSMART_API_KEY=your-secret-api-key-here-min-32-chars

# Database storage path
# Production (Render persistent disk): /var/data/fulfillsmart.db
# Local development: storage/fulfillsmart.db
FULFILLSMART_DATABASE_PATH=/var/data/fulfillsmart.db

# CORS Allowed Origins
# Specify your production Vercel domain. Do NOT include localhost in production.
# Example: https://fulfillsmart.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=https://fulfillsmart.vercel.app

# SQLite page cache size (MB)
CACHE_SIZE_MB=64

# ------------------------------------------------------------------------------
# 2. Frontend / Vercel Serverless Proxy Configuration (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Target Render backend URL (used by Vercel serverless proxy at /api/*)
BACKEND_API_URL=https://fulfillsmart-backend.onrender.com

# Injected server-side by the Vercel proxy into outgoing requests to Render
# MUST match FULFILLSMART_API_KEY configured on Render.
# NOTE: Never prefix with VITE_ to prevent bundling into client-side JavaScript.
# FULFILLSMART_API_KEY=your-secret-api-key-here-min-32-chars
